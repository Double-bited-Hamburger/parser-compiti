<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Avvisi di nuovi voti, verifiche, compiti e cambi d'orario (Lavori.kt). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Niente backup: nei dati dell'app ci sono voti e credenziali dei registri. -->
    <application
        android:name=".App"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/nessun_backup"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/nome_app"
        android:networkSecurityConfig="@xml/rete"
        android:supportsRtl="true"
        android:theme="@style/Tema">

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Widget in stile Nothing (Widget.kt). -->
        <receiver
            android:name=".WidgetCompiti"
            android:exported="false"
            android:label="@string/widget_compiti_nome">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_compiti_info" />
        </receiver>
        <receiver
            android:name=".WidgetVerifica"
            android:exported="false"
            android:label="@string/widget_verifica_nome">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_verifica_info" />
        </receiver>

        <receiver
            android:name=".WidgetAdesso"
            android:exported="false"
            android:label="@string/widget_adesso_nome">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_adesso_info" />
        </receiver>

        <!-- Serve solo a passare i PDF generati al lettore PDF del telefono. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.file"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/percorsi" />
        </provider>
    </application>

</manifest>
