<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 4×1 «Adesso»: a punti l'ora in cui finisce la lezione (o inizia la prossima), accanto materia e conto alla rovescia. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_sfondo"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <ImageView
        android:id="@+id/orario"
        android:layout_width="wrap_content"
        android:layout_height="30dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/widget_numero"
        android:scaleType="fitStart"
        android:tint="@color/widget_testo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/punto"
                android:layout_width="6dp"
                android:layout_height="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_punto" />

            <TextView
                android:id="@+id/etichetta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:fontFamily="monospace"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:text="@string/widget_adesso_titolo"
                android:textAllCaps="true"
                android:textColor="@color/widget_tenue"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/materia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="monospace"
            android:letterSpacing="0.06"
            android:maxLines="1"
            android:text="@string/widget_apri_app"
            android:textAllCaps="true"
            android:textColor="@color/widget_testo"
            android:textSize="13sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Chronometer
                android:id="@+id/conto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/widget_tenue"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/dopo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:letterSpacing="0.06"
                android:maxLines="1"
                android:textAllCaps="true"
                android:textColor="@color/widget_tenue"
                android:textSize="10sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
