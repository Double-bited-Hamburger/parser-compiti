<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 4×2 «Compiti»: quanti ne restano per il prossimo giorno di scuola (a punti) e di che materie. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_sfondo"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/punto"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_punto" />

        <TextView
            android:id="@+id/intestazione"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:maxLines="1"
            android:text="@string/widget_compiti_nome"
            android:textAllCaps="true"
            android:textColor="@color/widget_tenue"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/numero"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/widget_numero"
            android:scaleType="fitStart"
            android:tint="@color/widget_testo" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/elenco"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:fontFamily="monospace"
                android:letterSpacing="0.04"
                android:lineSpacingExtra="3dp"
                android:maxLines="4"
                android:text="@string/widget_apri_app"
                android:textAllCaps="true"
                android:textColor="@color/widget_testo"
                android:textSize="12sp" />

            <ImageView
                android:id="@+id/linea"
                android:layout_width="34dp"
                android:layout_height="2dp"
                android:layout_marginTop="6dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ultra_linea"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
