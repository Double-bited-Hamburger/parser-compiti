<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 2×2 «Prossima verifica»: i giorni che mancano (a punti, rossi all'ultimo giorno), la materia e quando. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/radice"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_sfondo"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/punto"
            android:layout_width="7dp"
            android:layout_height="7dp"
            android:importantForAccessibility="no"
            android:src="@drawable/widget_punto" />

        <TextView
            android:id="@+id/titolo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:text="@string/widget_verifica_titolo"
            android:textAllCaps="true"
            android:textColor="@color/widget_tenue"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/giorni"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/widget_numero"
            android:scaleType="fitStart"
            android:tint="@color/widget_testo" />

        <TextView
            android:id="@+id/giorni_etichetta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:layout_marginStart="6dp"
            android:fontFamily="monospace"
            android:letterSpacing="0.12"
            android:textAllCaps="true"
            android:textColor="@color/widget_tenue"
            android:textSize="10sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/linea"
        android:layout_width="34dp"
        android:layout_height="2dp"
        android:layout_marginBottom="6dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ultra_linea"
        android:visibility="gone" />

    <TextView
        android:id="@+id/materia"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:letterSpacing="0.06"
        android:maxLines="1"
        android:text="@string/widget_apri_app"
        android:textAllCaps="true"
        android:textColor="@color/widget_testo"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/quando"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:letterSpacing="0.06"
        android:maxLines="1"
        android:textAllCaps="true"
        android:textColor="@color/widget_tenue"
        android:textSize="10sp" />
</LinearLayout>
